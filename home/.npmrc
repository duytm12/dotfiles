# Global npm / pnpm config.
# Managed by dotfiles: home.nix symlinks this to ~/.npmrc, so edits here are live.

# Keep the single content-addressable pnpm store in a predictable place.
store-dir=~/.local/share/pnpm/store

# Where pnpm links globally installed package binaries (matches PNPM_HOME).
global-bin-dir=~/.local/share/pnpm

# Use the exact version specifier when adding deps instead of a caret range.
save-exact=true

# Fail installs on engine (node/pnpm version) mismatch rather than warning.
engine-strict=true
